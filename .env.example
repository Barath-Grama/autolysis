# Copy this file to .env (and `export $(cat .env | xargs)` or use a tool like
# direnv / python-dotenv) or just export these directly in your shell.

# Required unless you run with --offline.
# Get a free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: overrides the default model (gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite
